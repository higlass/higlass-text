{
  "name": "higlass-text",
  "version": "1.0.0",
  "description": "Text track for HiGlass",
  "author": "Alexander Veit",
  "license": "MIT",
  "contributors": [
    {
      "name": "Alexander Veit",
      "url": "http://github.com/alexander-veit"
    }
  ],
  "repository": "github:higlass/higlass-text",
  "keywords": ["higlass", "plugin", "track", "text"],
  "main": "./dist/higlass-text.js",
  "module": "./dist/higlass-text.mjs",
  "unpkg": "./dist/higlass-text.js",
  "jsdelivr": "./dist/higlass-text.js",
  "exports": {
    ".": {
      "import": "./dist/higlass-text.mjs",
      "require": "./dist/higlass-text.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "CHANGELOG.md"],
  "sideEffects": ["./dist/higlass-text.js"],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && vite build --mode umd",
    "test": "vitest run",
    "test-watch": "vitest watch",
    "lint": "biome ci",
    "format": "biome format --write"
  },
  "peerDependencies": {
    "higlass": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/browser": "^3.2.4",
    "higlass": "^2.3.5",
    "pixi.js": "^6.5.10",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
